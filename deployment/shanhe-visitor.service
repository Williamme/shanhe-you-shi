[Unit]
Description=Shanhe You Shi anonymous visitor counter
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/shanhe-you-shi
Environment=VISITOR_PORT=4174
Environment=VISITOR_DATA_FILE=/var/lib/shanhe-you-shi/visitors.json
ExecStart=/usr/local/bin/node /var/www/shanhe-you-shi/visitor-server.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shanhe-you-shi

[Install]
WantedBy=multi-user.target
